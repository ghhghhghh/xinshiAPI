{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "信使",
  "version": "1.1.0",
  "identifier": "com.zx.rustone",
  "build": {
    "beforeDevCommand": "npm run ai:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ai:prepare -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "信使 API",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/skills"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
